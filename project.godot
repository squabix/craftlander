; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CRAFTLANDER"
config/version="1.0"
run/main_scene="uid://xw1mkjxlbnke"
config/use_custom_user_dir=true
config/custom_user_dir_name="CRAFTLANDER"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.036900003, 0.060795017, 0.09, 1)
boot_splash/image="uid://6rsobsln1x1t"
config/icon="uid://cvnfk2w1gki1v"

[audio]

buses/default_bus_layout="uid://dfnaxtxyuayj3"

[autoload]

SoundManager="*res://common/sound/sound_manager.gd"
RecipeBook="*res://items/crafting/recipe_book.gd"
GameSettings="*uid://dybhrs6lws1mr"

[debug]

file_logging/log_path="user://logs/craftlander.log"
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="uid://eqnnqfimn3ng"
mouse_cursor/custom_image_hotspot=Vector2(12, 12)

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/IgnoreFolders/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "orange",
"res://boat/": "blue",
"res://common/": "yellow",
"res://common3d/": "red",
"res://defaults/": "blue",
"res://entities/": "green",
"res://island/": "yellow",
"res://island/props/destructable_resource/": "pink",
"res://island/props/indestructable/": "blue",
"res://island/props/item_dropper_props/": "orange",
"res://items/": "teal",
"res://items/crafting/": "gray",
"res://items/food/": "orange",
"res://main/": "gray",
"res://player/": "blue",
"res://player/ui/": "green"
}

[global_group]

player=""
navigation_mesh_source_group=""

[gui]

theme/custom="uid://dy5fmdtb6xfr7"

